# ── App ────────────────────────────────────────────────────────────────────
APP_ENV=development
PORT=8090

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://p5wellness:p5wellness_dev@localhost:5433/p5wellness?sslmode=disable

# ── Segredos (gerar valores aleatórios fortes em produção) ───────────────────
JWT_SECRET=
QR_HMAC_SECRET=
PASSWORD_PEPPER=

# ── SMTP (Hostgator/cPanel em produção, Gmail só em dev) ──────────────────────
# Produção: mail.p5beachclub.com.br, porta 465 (SSL) — ver docs/EMAIL_DNS_SETUP.md
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="P5 DownWind Day <wellness@p5beachclub.com.br>"

# ── Asaas ──────────────────────────────────────────────────────────────────
ASAAS_API_KEY=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_WEBHOOK_TOKEN=

# ── URLs públicas (para CORS e links em e-mail) ───────────────────────────────
# Site e painel da equipe são o mesmo app agora (mesma porta em dev).
PUBLIC_SITE_URL=http://localhost:5183
PUBLIC_ADMIN_URL=http://localhost:5183
