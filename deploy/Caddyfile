# Caddy emite/renova HTTPS automaticamente via Let's Encrypt para cada domínio listado.

wellness.p5beachclub.com.br {
	handle /api/* {
		reverse_proxy backend:8090
	}

	handle {
		root * /srv/site
		try_files {path} /index.html
		file_server
	}

	encode gzip zstd
}

wellness-admin.p5beachclub.com.br {
	handle /api/* {
		reverse_proxy backend:8090
	}

	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}

	encode gzip zstd

	# Painel interno: não deixar buscadores indexarem.
	header X-Robots-Tag "noindex, nofollow"
}

# Domínio dedicado da API — usado como URL do webhook da Asaas
# (https://wellness-api.p5beachclub.com.br/api/v1/webhooks/asaas) e para chamadas
# diretas ao backend. Mesma origem física do backend das duas entradas acima, só
# que sem servir nenhum estático — tudo aqui é a API.
wellness-api.p5beachclub.com.br {
	reverse_proxy backend:8090
	encode gzip zstd
}
