# Caddy emite/renova HTTPS automaticamente via Let's Encrypt para cada domínio listado.

downwindday.p5beachclub.com.br {
	handle /api/* {
		reverse_proxy backend:8090
	}

	# Painel interno da equipe (check-in e admin) — mesma origem do site público,
	# só marcado pra não ser indexado por buscadores.
	handle /admin* {
		header X-Robots-Tag "noindex, nofollow"
		root * /srv/site
		try_files {path} /index.html
		file_server
	}
	handle /check-in* {
		header X-Robots-Tag "noindex, nofollow"
		root * /srv/site
		try_files {path} /index.html
		file_server
	}

	handle {
		root * /srv/site
		try_files {path} /index.html
		file_server
	}

	encode gzip zstd
}

# Domínio dedicado da API — usado como URL do webhook da Asaas
# (https://downwindday-api.p5beachclub.com.br/api/v1/webhooks/asaas) e para chamadas
# diretas ao backend. Mesma origem física do backend da entrada acima, só que sem
# servir nenhum estático — tudo aqui é a API.
downwindday-api.p5beachclub.com.br {
	reverse_proxy backend:8090
	encode gzip zstd
}
