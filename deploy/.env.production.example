# Copie para `.env` na RAIZ do repositório (mesmo nível de docker-compose.prod.yml,
# um nível acima de deploy/) antes de rodar `docker compose -f deploy/docker-compose.prod.yml up`.
# Esse arquivo é diferente do backend/.env usado em desenvolvimento — nunca reutilize
# os valores de dev aqui. Nunca commitar o `.env` real (já está no .gitignore).

# ── Banco de dados ────────────────────────────────────────────────────────────
POSTGRES_USER=p5wellness
POSTGRES_PASSWORD=                          # gerar senha forte, só para este ambiente
POSTGRES_DB=p5wellness

# ── Segredos da aplicação (gerar com: openssl rand -hex 32) ──────────────────
JWT_SECRET=
QR_HMAC_SECRET=
PASSWORD_PEPPER=

# ── SMTP — mail.p5beachclub.com.br (Hostgator/cPanel), com SPF/DKIM/DMARC ────
# Ver docs/EMAIL_DNS_SETUP.md antes de habilitar. Porta 465 = SSL implícito (o
# dialer detecta automaticamente); 587 = STARTTLS.
SMTP_HOST=mail.p5beachclub.com.br
SMTP_PORT=465
SMTP_USER=wellness@p5beachclub.com.br
SMTP_PASS=
SMTP_FROM="P5 Wellness Club <wellness@p5beachclub.com.br>"

# ── Asaas — chave e webhook de PRODUÇÃO (nunca a de sandbox aqui) ────────────
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=

# ── Domínios reais ────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://wellness.p5beachclub.com.br
PUBLIC_ADMIN_URL=https://wellness-admin.p5beachclub.com.br
